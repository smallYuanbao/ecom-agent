# 复制为 .env 后填写。启动时缺必填项会直接失败。
APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 模型
CHAT_MODEL=deepseek-chat
EMBED_MODEL=bge-m3
CHAT_API_KEY=            # 必填
CHAT_BASE_URL=

# 版本快照（/api/meta 返回，评测不可比判断依赖它）
PROMPT_VERSION=v1
# KB_VERSION 由内容哈希自动生成，无需手填

# 可选：Langfuse 观测（三个都不填则完全关闭）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
