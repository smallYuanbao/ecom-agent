# 复制为 .env 后填写。启动时缺必填项会直接失败。
APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Ch07 评测门面：只在评测实例打开（默认关闭，关闭时返回 404）
ENABLE_EVAL_API=false

# 模型
CHAT_MODEL=deepseek-chat
EMBED_MODEL=bge-m3
CHAT_API_KEY=            # 必填
CHAT_BASE_URL=

# 向量库（本地 Docker；8000 已被 Chroma 占用，本服务请用 8080）
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=ecom_kb    # 必须独立，不要复用 rag_docs 等既有集合

# Embedding（本地 Ollama，bge-m3 = 1024 维）
OLLAMA_BASE_URL=http://localhost:11434

# 检索参数：起步值，未校准（见 ch02 spec「参数来源与状态」）
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
EVIDENCE_THRESHOLD=0.55      # 余弦相似度（= 1 - distance），不是 RRF 分数

# 版本快照（/api/meta 返回，评测不可比判断依赖它）
PROMPT_VERSION=v1
# KB_VERSION 由内容哈希自动生成，无需手填

# 可选：Langfuse 观测（三个都不填则完全关闭）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Ch07 评测集外部生成（scripts/generate_eval_candidates.py）
# 多个模型共用同一个 key / base URL，只换模型名；逗号分隔
EVAL_GEN_API_KEY=
EVAL_GEN_BASE_URL=
EVAL_GEN_MODELS=
EVAL_GEN_TIMEOUT=120
EVAL_GEN_MAX_RETRIES=2
